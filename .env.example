# API Configuration
# Option 1: Legacy single model configuration
API_KEY=your_api_key_here
BASE_URL=https://your-base-url-1.com
MODEL=your_model_name

# Option 2: Multiple models configuration (recommended)
# Model 1
MODEL_1=model_id_1
